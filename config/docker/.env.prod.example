# ============================================================
# 生产环境变量模板（M7 设计 §6，D58）
# 复制为 ECS 上的 .env（不入仓库、不入镜像），由云效凭据库/部署脚本注入真实值。
# 无默认值项缺失即启动失败（fail-fast，application-prod.yml 不提供默认值）。
# ============================================================

# ---- ACR 镜像（docker-compose.prod.yml 使用） ----
ACR_NAMESPACE=<acr-registry-vpc>/<namespace>
APP_TAG=v1.0.0

# ---- 数据库（RDS PostgreSQL 18，VPC 内网地址） ----
DB_URL=jdbc:postgresql://<rds-internal-host>:5432/<db_name>
DB_USERNAME=<db_app_user>
DB_PASSWORD=<strong-db-password>

# ---- 密钥（云效凭据库托管；JWT HS256 ≥32 字节，AES 32 字节 Base64） ----
# 生产务必使用随机生成的强密钥，且 dev/test/prod 三环境互不相同
JWT_SECRET=<base64-≥32-bytes-random-secret>
DATA_ENCRYPTION_KEY=<base64-32-bytes-random-key>

# ---- 可选：令牌 TTL / 登录锁定（不设则用 application.yml 默认值） ----
# JWT_ACCESS_TTL=PT15M
# JWT_REFRESH_TTL=P14D
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_DURATION=PT15M

# ---- 业务开关（生产默认） ----
# AI（GA D67）：真实大模型 = DeepSeek（经 Spring AI OpenAI 兼容协议）
AI_MOCK=false
SPRING_AI_MODEL_CHAT=openai
# DeepSeek API Key 由云效凭据库托管；AI_MOCK=false 时缺失即启动失败（fail-fast）
DEEPSEEK_API_KEY=<deepseek-api-key>
# 端点与模型有默认值（application.yml），专有云/新模型可覆盖
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro

# ---- 外部推送（GA D68）：鸿蒙 Push Kit ----
NOTIFY_PUSH_ENABLED=true
# 鸿蒙 Push Kit 服务端凭据（AppGallery Connect），启用推送时缺失即启动失败（fail-fast）
HARMONY_PUSH_APP_ID=<harmony-app-id>
HARMONY_PUSH_CLIENT_ID=<harmony-client-id>
HARMONY_PUSH_CLIENT_SECRET=<harmony-client-secret>
# OAuth2 / 下发端点有官方默认值，专有云可覆盖
# HARMONY_PUSH_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
# HARMONY_PUSH_BASE_URL=https://push-api.cloud.huawei.com
