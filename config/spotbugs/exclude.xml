<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs 排除清单：每条排除必须附理由注释，随里程碑 DoD 复审。
     原则：仅排除"框架惯例下的确定性误报"，不排除真实缺陷。 -->
<FindBugsFilter>

    <!-- HRS_REQUEST_PARAMETER_TO_HTTP_HEADER：TraceIdFilter 将外部传入的
         X-Trace-Id 写入响应头前，经 TraceIds.isAcceptable() 白名单校验
         （仅放行 [A-Za-z0-9_-]{1,64}，CR/LF/空白等注入字符一律拒绝并重新
         生成），CRLF 响应头注入不可达。SpotBugs 无法跨方法识别该校验。 -->
    <Match>
        <Class name="wyq.pocket.money.common.trace.TraceIdFilter"/>
        <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
    </Match>

    <!-- EI_EXPOSE_REP2：Spring DI 注入的容器级单例（JsonMapper 为 Boot 4
         自动装配、Jackson 官方约定配置完成后线程安全共享；JwtTokenService /
         SecurityLogger 组件为无状态服务）。注入后只读使用、从不修改，
         "存储外部可变对象"在容器单例场景为误报。 -->
    <Match>
        <Class name="wyq.pocket.money.common.security.handler.RestAuthenticationEntryPoint"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.common.security.handler.RestAccessDeniedHandler"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.common.security.filter.JwtAuthenticationFilter"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- EI_EXPOSE_REP2：同上 —— AuditLogMapper 为 MyBatis 代理的容器单例，
         构造注入后仅调用其接口方法，无可变状态外泄。 -->
    <Match>
        <Class name="wyq.pocket.money.common.audit.AuditService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP2：user 模块 service / controller 构造注入的协作者
         一律为容器级单例（MyBatis Mapper 代理、@Service/@Component、
         PasswordEncoder bean），注入后仅调用其方法、不修改其状态，
         “存储外部可变对象”在该惯例下为误报。 -->
    <Match>
        <Class name="~wyq\.pocket\.money\.user\.(service|controller)\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2：FamilyDetailResponse 为响应 DTO
         record，紧凑构造器已用 List.copyOf 固化成员列表（构造后不可变），
         外部调用方无法再改写内部状态，访问器返回的是不可变快照。
         SpotBugs 无法识别 record 内的该防御性拷贝，两条均为确定性误报；
         后续含 List 组件的响应 DTO 沿用此模式时按类增补本条。 -->
    <Match>
        <Class name="wyq.pocket.money.user.dto.FamilyDetailResponse"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.user.dto.FamilyDetailResponse"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
