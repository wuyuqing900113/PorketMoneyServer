<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs 排除清单：每条排除必须附理由注释，随里程碑 DoD 复审。
     原则：仅排除"框架惯例下的确定性误报"，不排除真实缺陷。 -->
<FindBugsFilter>

    <!-- HRS_REQUEST_PARAMETER_TO_HTTP_HEADER：TraceIdFilter 将外部传入的
         X-Trace-Id 写入响应头前，经 TraceIds.isAcceptable() 白名单校验
         （仅放行 [A-Za-z0-9_-]{1,64}，CR/LF/空白等注入字符一律拒绝并重新
         生成），CRLF 响应头注入不可达。SpotBugs 无法跨方法识别该校验。 -->
    <Match>
        <Class name="wyq.pocket.money.common.trace.TraceIdFilter"/>
        <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
    </Match>

    <!-- EI_EXPOSE_REP2：Spring DI 注入的容器级单例（JsonMapper 为 Boot 4
         自动装配、Jackson 官方约定配置完成后线程安全共享；JwtTokenService /
         SecurityLogger 组件为无状态服务）。注入后只读使用、从不修改，
         "存储外部可变对象"在容器单例场景为误报。 -->
    <Match>
        <Class name="wyq.pocket.money.common.security.handler.RestAuthenticationEntryPoint"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.common.security.handler.RestAccessDeniedHandler"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.common.security.filter.JwtAuthenticationFilter"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- EI_EXPOSE_REP2：同上 —— AuditLogMapper 为 MyBatis 代理的容器单例，
         构造注入后仅调用其接口方法，无可变状态外泄。 -->
    <Match>
        <Class name="wyq.pocket.money.common.audit.AuditService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP2：user 模块 service / controller 构造注入的协作者
         一律为容器级单例（MyBatis Mapper 代理、@Service/@Component、
         PasswordEncoder bean），注入后仅调用其方法、不修改其状态，
         “存储外部可变对象”在该惯例下为误报。 -->
    <Match>
        <Class name="~wyq\.pocket\.money\.user\.(service|controller)\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP2：同上 —— M2 业务模块（money / rule / finance）
         service（含 service.event 监听器）、controller、job 构造注入的
         协作者同样一律为容器级单例（MyBatis Mapper 代理、@Service/@Component、
         Clock），注入后仅调用其方法、不修改其状态，同一惯例下的误报。 -->
    <Match>
        <Class name="~wyq\.pocket\.money\.(money|rule|finance)\.(service|controller|job)\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2：FamilyDetailResponse 为响应 DTO
         record，紧凑构造器已用 List.copyOf 固化成员列表（构造后不可变），
         外部调用方无法再改写内部状态，访问器返回的是不可变快照。
         SpotBugs 无法识别 record 内的该防御性拷贝，两条均为确定性误报；
         后续含 List 组件的响应 DTO 沿用此模式时按类增补本条。 -->
    <Match>
        <Class name="wyq.pocket.money.user.dto.FamilyDetailResponse"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.user.dto.FamilyDetailResponse"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2：同 FamilyDetailResponse 模式 ——
         以下 M2 响应 DTO record 的紧凑构造器已用 List.copyOf / Map.copyOf
         固化集合组件（构造后不可变），访问器返回的是不可变快照。
         SpotBugs 无法识别 record 内的防御性拷贝，两条均为确定性误报。 -->
    <Match>
        <Class name="wyq.pocket.money.money.dto.DashboardResponse"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.money.dto.DashboardResponse"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.money.dto.LeaderboardResponse"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.money.dto.LeaderboardResponse"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.money.dto.LearningTaskPageResponse"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.money.dto.LearningTaskPageResponse"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.money.dto.TransactionPageResponse"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.money.dto.TransactionPageResponse"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.money.dto.TrendResponse"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.money.dto.TrendResponse"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.rule.dto.RuleDetailResponse"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.rule.dto.RuleDetailResponse"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.finance.dto.IncomeExpenseReportResponse"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="wyq.pocket.money.finance.dto.IncomeExpenseReportResponse"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2：common.idempotency / common.resilience
         为 M3 新增的拦截器、幂等服务、清理任务与请求体缓存包装器。其构造注入
         的协作者一律为容器级单例（MyBatis Mapper 代理、@Component 的
         IdempotencyService / RateLimitService、Jackson 3 JsonMapper、Clock），
         注入后仅调用方法、不修改状态；IdempotencyOutcome 访问器返回的
         IdempotencyRecord 为两阶段幂等的中间结果，调用方（拦截器）只读使用；
         CachedBodyRequestWrapper.getBody() 返回缓存的请求体字节，仅用于拦截器
         内单次读取回放。均属同一惯例下的确定性误报。 -->
    <Match>
        <Class name="~wyq\.pocket\.money\.common\.(idempotency|resilience)\..*"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="~wyq\.pocket\.money\.common\.(idempotency|resilience)\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP2：ai 模块 service / controller / job 构造注入的协作者
         一律为容器级单例（MyBatis Mapper 代理、@Service/@Component、Clock、
         Jackson 3 JsonMapper），注入后仅调用其方法、不修改其状态，
         "存储外部可变对象"在该惯例下为误报。 -->
    <Match>
        <Class name="~wyq\.pocket\.money\.ai\.(service|controller|job)\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2：common.ai 为 M4 抽象层，其中
         IntentResult / ToolDefinition 值记录紧凑构造器已用 Map.copyOf 固化
         参数映射（构造后不可变），其余 ChatPort 等为纯接口。访问器返回
         不可变快照，SpotBugs 无法识别 record 内的防御性拷贝，两条均为误报。 -->
    <Match>
        <Class name="~wyq\.pocket\.money\.common\.ai\..*"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="~wyq\.pocket\.money\.common\.ai\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2：EvalCase 评测样本值记录，紧凑构造器
         已用 Map.copyOf 固化期望参数（构造后不可变）。同 DTO 记录惯例的误报。 -->
    <Match>
        <Class name="~wyq\.pocket\.money\.ai\.eval\..*"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="~wyq\.pocket\.money\.ai\.eval\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_REP：IntentCatalog.toolDefinitions() 返回的 definitions
         字段已在构造期以 List.copyOf 固化为不可变清单，调用方无法改写。
         SpotBugs 无法识别字段初始化处的防御性拷贝，属确定性误报。 -->
    <Match>
        <Class name="wyq.pocket.money.ai.service.IntentCatalog"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

</FindBugsFilter>
